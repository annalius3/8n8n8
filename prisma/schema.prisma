generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueStatus {
  pending
  generating
  ready
  publishing
  processing
  published
  failed
}

enum RunStatus {
  success
  failed
  running
}

enum StepExecStatus {
  success
  failed
  skipped
}

enum AutoPostJobStatus {
  pending
  generated
  scheduled
  publishing
  published
  failed
  skipped
  disabled
}

enum SocialPlatform {
  twitter
  linkedin
  reddit
  telegram
  pinterest
  medium
  facebook
}

enum SearchConsolePeriod {
  today
  last_7_days
  last_28_days
  last_3_months
}

enum SearchConsoleDevice {
  desktop
  mobile
  tablet
  other
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  connections    Connection[]
  flows          Flow[]
  postQueueItems PostQueueItem[]
  articleSourceConfigs ArticleSourceConfig[]
  articles       Article[]
  autoPostPlatformSettings AutoPostPlatformSetting[]
  subredditMappings AutoPostSubredditMapping[]
  sites          Site[]
  siteSearchConsoleConnections SiteSearchConsoleConnection[]

  @@map("users")
}

model Site {
  id                String                           @id @default(cuid())
  userId            String                           @map("user_id")
  name              String
  domain            String
  notes             String?
  lastSyncAt        DateTime?                        @map("last_sync_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")
  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchConsoleConnection SiteSearchConsoleConnection?
  dailyStats        SiteSearchConsoleDailyStat[]
  queries           SiteSearchConsoleQuery[]
  pages             SiteSearchConsolePage[]
  countries         SiteSearchConsoleCountry[]
  devices           SiteSearchConsoleDeviceMetric[]

  @@index([userId, createdAt])
  @@index([userId, domain])
  @@map("sites")
}

model SiteSearchConsoleConnection {
  id                String                 @id @default(cuid())
  siteId            String                 @unique @map("site_id")
  userId            String                 @map("user_id")
  googleAccountEmail String?               @map("google_account_email")
  propertyUrl       String?                @map("property_url")
  encryptedJson     String                 @map("encrypted_json")
  tokenExpiresAt    DateTime?              @map("token_expires_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  site              Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("site_search_console_connections")
}

model SiteSearchConsoleDailyStat {
  id          String   @id @default(cuid())
  siteId       String   @map("site_id")
  date         DateTime
  clicks       Float
  impressions  Float
  ctr          Float
  position     Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([siteId, date])
  @@map("site_search_console_daily_stats")
}

model SiteSearchConsoleQuery {
  id          String              @id @default(cuid())
  siteId      String              @map("site_id")
  period      SearchConsolePeriod
  query       String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  syncedAt    DateTime            @map("synced_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, period, query])
  @@index([siteId, period, clicks])
  @@map("site_search_console_queries")
}

model SiteSearchConsolePage {
  id          String              @id @default(cuid())
  siteId      String              @map("site_id")
  period      SearchConsolePeriod
  pageUrl     String              @map("page_url")
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  syncedAt    DateTime            @map("synced_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, period, pageUrl])
  @@index([siteId, period, clicks])
  @@map("site_search_console_pages")
}

model SiteSearchConsoleCountry {
  id          String              @id @default(cuid())
  siteId      String              @map("site_id")
  period      SearchConsolePeriod
  country     String
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  syncedAt    DateTime            @map("synced_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, period, country])
  @@index([siteId, period, clicks])
  @@map("site_search_console_countries")
}

model SiteSearchConsoleDeviceMetric {
  id          String              @id @default(cuid())
  siteId      String              @map("site_id")
  period      SearchConsolePeriod
  device      SearchConsoleDevice
  clicks      Float
  impressions Float
  ctr         Float
  position    Float
  syncedAt    DateTime            @map("synced_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  site        Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, period, device])
  @@index([siteId, period, clicks])
  @@map("site_search_console_devices")
}

model ArticleSourceConfig {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  sourceType              String   @default("rss") @map("source_type")
  rssUrl                  String?  @map("rss_url")
  baseUrl                 String?  @map("base_url")
  enabled                 Boolean  @default(true)
  immediatePublishEnabled Boolean  @default(false) @map("immediate_publish_enabled")
  assetsPersistenceEnabled Boolean @default(true) @map("assets_persistence_enabled")
  lastScannedAt           DateTime? @map("last_scanned_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("article_source_configs")
}

model Article {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  sourceType       String   @default("rss") @map("source_type")
  sourceUid        String   @map("source_uid")
  canonicalUrl     String   @map("canonical_url")
  title            String
  category         String?
  excerpt          String?
  content          String
  publishedAt      DateTime @map("published_at")
  autopostEnabled  Boolean  @default(true) @map("autopost_enabled")
  assetsGeneratedAt DateTime? @map("assets_generated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs             AutoPostJob[]
  assets           AutoPostAsset[]

  @@unique([userId, sourceType, sourceUid])
  @@index([userId, publishedAt])
  @@index([userId, autopostEnabled])
  @@map("articles")
}

model AutoPostPlatformSetting {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  platform           SocialPlatform
  enabled            Boolean        @default(false)
  maxPostsPerDay     Int            @default(10) @map("max_posts_per_day")
  minIntervalMinutes Int            @default(30) @map("min_interval_minutes")
  requireApproval    Boolean        @default(false) @map("require_approval")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId, enabled])
  @@map("autopost_platform_settings")
}

model AutoPostJob {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  articleId      String            @map("article_id")
  platform       SocialPlatform
  status         AutoPostJobStatus @default(pending)
  generatedContent Json?           @map("generated_content")
  externalPostId String?           @map("external_post_id")
  errorMessage   String?           @map("error_message")
  scheduledAt    DateTime?         @map("scheduled_at")
  publishedAt    DateTime?         @map("published_at")
  attempts       Int               @default(0)
  lastAttemptAt  DateTime?         @map("last_attempt_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  article        Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, platform])
  @@index([userId, platform, status, scheduledAt])
  @@index([articleId, status])
  @@map("autopost_jobs")
}

model AutoPostAsset {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  articleId   String         @map("article_id")
  platform    SocialPlatform
  title       String?
  body        String?
  hashtags    String[]
  imagePrompt String?        @map("image_prompt")
  metadataJson Json?         @map("metadata_json")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  article     Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, platform])
  @@map("autopost_assets")
}

model AutoPostSubredditMapping {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  category     String?
  keyword      String?
  subreddit    String
  isEnabled    Boolean  @default(true) @map("is_enabled")
  manualOnly   Boolean  @default(true) @map("manual_only")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled])
  @@map("autopost_subreddit_mappings")
}

model Connection {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  provider      String
  name          String
  encryptedJson String   @map("encrypted_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@map("connections")
}

model Flow {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  name               String
  isEnabled          Boolean           @default(true) @map("is_enabled")
  seedTopic          String?           @map("seed_topic")
  language           String            @default("EN")
  niche              String?
  audience           String?
  tone               String?
  postsPerDay        Int               @default(3) @map("posts_per_day")
  timezone           String            @default("Europe/Kiev")
  startTime          String            @default("09:00") @map("start_time")
  autopublishEnabled Boolean           @default(false) @map("autopublish_enabled")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps              FlowStep[]
  schedule           FlowSchedule?
  runs               JobRun[]
  topicSuggestions   TopicSuggestion[]
  queueItems         PostQueueItem[]

  @@map("flows")
}

model FlowStep {
  id         String   @id @default(cuid())
  flowId     String   @map("flow_id")
  orderIndex Int      @map("order_index")
  type       String
  configJson Json     @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  flow       Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, orderIndex])
  @@index([flowId, type])
  @@map("flow_steps")
}

model FlowSchedule {
  id            String    @id @default(cuid())
  flowId         String    @unique @map("flow_id")
  cron           String
  timezone       String    @default("Europe/Kiev")
  maxRunsPerDay  Int       @default(10) @map("max_runs_per_day")
  nextRunAt      DateTime  @map("next_run_at")
  lastRunAt      DateTime? @map("last_run_at")
  isPaused       Boolean   @default(false) @map("is_paused")
  flow           Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([nextRunAt, isPaused])
  @@map("flow_schedules")
}

model TopicSuggestion {
  id         String   @id @default(cuid())
  flowId      String   @map("flow_id")
  topicText   String   @map("topic_text")
  selected    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, createdAt])
  @@map("topic_suggestions")
}

model PostQueueItem {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  flowId       String?     @map("flow_id")
  status      QueueStatus @default(pending)
  topicText    String?     @map("topic_text")
  lockedAt    DateTime?   @map("locked_at")
  scheduledAt  DateTime?   @map("scheduled_at")
  publishedAt DateTime?   @map("published_at")
  error       String?
  title       String
  body        String
  linkUrl     String?     @map("link_url")
  imagePrompt String?     @map("image_prompt")
  imageGenerationId String? @map("image_generation_id")
  imageUrl     String?     @map("image_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flow        Flow?       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runs        JobRun[]

  @@index([status, lockedAt])
  @@index([flowId, status, scheduledAt])
  @@map("post_queue_items")
}

model PublishedItem {
  id             String   @id @default(cuid())
  sourceType     String   @map("source_type")
  sourceUid      String   @map("source_uid")
  platform       String
  platformPostId String?  @map("platform_post_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceType, sourceUid, platform])
  @@map("published_items")
}

model JobRun {
  id          String      @id @default(cuid())
  flowId       String      @map("flow_id")
  queueItemId  String?     @map("queue_item_id")
  status       RunStatus   @default(running)
  startedAt    DateTime    @default(now()) @map("started_at")
  finishedAt   DateTime?   @map("finished_at")
  error        String?
  contextJson  Json?       @map("context_json")
  flow         Flow        @relation(fields: [flowId], references: [id], onDelete: Cascade)
  queueItem    PostQueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  steps        JobRunStep[]

  @@index([flowId, startedAt])
  @@index([queueItemId, startedAt])
  @@map("job_runs")
}

model JobRunStep {
  id         String         @id @default(cuid())
  jobRunId   String         @map("job_run_id")
  stepIndex  Int            @map("step_index")
  stepType   String         @map("step_type")
  inputJson  Json?          @map("input_json")
  outputJson Json?          @map("output_json")
  status     StepExecStatus
  error      String?
  startedAt  DateTime       @default(now()) @map("started_at")
  finishedAt DateTime?      @map("finished_at")
  jobRun     JobRun         @relation(fields: [jobRunId], references: [id], onDelete: Cascade)

  @@index([jobRunId, stepIndex])
  @@map("job_run_steps")
}
